{% extends 'base.html.twig' %}
{% block body %}
    <h1 class="h3 mb-3">Instellingen {{ huidige_afdeling().naam }}</h1>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card"><div class="card-header fw-semibold">Afdeling</div><div class="card-body">
                {{ form_start(form) }}
                {{ form_rest(form) }}
                <button class="btn btn-primary"><i class="bi bi-save"></i> Opslaan</button>
                {{ form_end(form) }}
            </div></div>
            <div class="card mt-4"><div class="card-header fw-semibold">Afsluitmails (laatste 50)</div><div class="card-body table-responsive">
                <table class="table table-sm"><thead><tr><th>Lijst</th><th>Status</th><th>Pogingen</th><th>Fout</th><th></th></tr></thead><tbody>
                {% for m in mail_log %}<tr><td>{{ m.nummer }}</td><td>{{ m.status }}</td><td>{{ m.pogingen }}</td><td class="small">{{ m.fout }}</td><td>
                {% if m.status != 'verzonden' %}<form method="post" action="{{ path('app_instellingen_mail_opnieuw', {id: m.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('afsluitmail' ~ m.id) }}"><button class="btn btn-sm btn-outline-primary">Opnieuw</button></form>{% endif %}
                </td></tr>{% else %}<tr><td colspan="5">Nog geen verzendregistraties.</td></tr>{% endfor %}
                </tbody></table><p class="small text-muted">Verzonden betekent aan de mailserver aangeboden, niet noodzakelijk afgeleverd.</p>
            </div></div>
            <div class="card mt-4"><div class="card-header fw-semibold">Chauffeursregistratie per post</div><div class="card-body">
                <p>Standaard voor {{ huidige_afdeling().naam }}: <strong>{{ huidige_afdeling().chauffeursActief ? 'Aan' : 'Uit' }}</strong>. Je kunt hieronder per post afwijken. De instelling geldt voor de post van de lijst en alleen binnen deze afdeling.</p>
                <form method="post" action="{{ path('app_instellingen_chauffeurs') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('chauffeur_instellingen') }}">
                    {% for post in chauffeur_posten %}
                        {% set waarde = chauffeur_instellingen[post.id]|default('standaard') %}
                        <div class="row align-items-center mb-2">
                            <label class="col-sm-5 col-form-label" for="chauffeur-post-{{ post.id }}">{{ post.naam }}</label>
                            <div class="col-sm-7"><select class="form-select" name="posten[{{ post.id }}]" id="chauffeur-post-{{ post.id }}">
                                <option value="standaard" {{ waarde == 'standaard' ? 'selected' }}>Volg afdelingsinstelling</option>
                                <option value="aan" {{ waarde == 'aan' ? 'selected' }}>Aan</option>
                                <option value="uit" {{ waarde == 'uit' ? 'selected' }}>Uit</option>
                            </select></div>
                        </div>
                    {% endfor %}
                    <button class="btn btn-primary mt-2">Chauffeursinstellingen opslaan</button>
                </form>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Tik-pc's en administrator</span>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_systeemaccount_nieuw') }}"><i class="bi bi-plus"></i> Tik-pc</a>
                </div>
                <ul class="list-group list-group-flush">
                    {% for a in accounts %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">{{ a.naam }} <span class="text-body-secondary fw-normal">· {{ a.voornaam }}</span></div>
                                <div class="small text-body-secondary">{{ a.actief ? 'Actief' : 'INACTIEF' }} · Nr. {{ a.tiknummer }} · {{ a.rol.label }}{{ a.post ? ' · post ' ~ a.post.naam }}{{ a.vastPeloton ? ' · ' ~ a.vastPeloton|peloton }}</div>
                            </div>
                            {% if a.rol.value != 'admin' or is_granted('ROLE_ADMIN') %}
                                <a class="btn btn-sm btn-link" href="{{ path('app_systeemaccount_bewerken', {id: a.id}) }}"><i class="bi bi-pencil"></i></a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('vendor/tom-select/tom-select.bootstrap5.min.css') }}">{% endblock %}
{% block javascripts %}<script src="{{ asset('vendor/tom-select/tom-select.complete.min.js') }}"></script>{% endblock %}
{% block body %}
    {% set filter = {persoon: persoon.id != app.user.id ? persoon.id : null, van: van ? van|date('Y-m-d') : null, tot: tot ? tot|date('Y-m-d') : null}|filter(v => v is not null) %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">Prestaties {{ persoon.id != app.user.id ? 'van ' ~ persoon.voornaam ~ ' ' ~ persoon.naam }}</h1>
        <a class="btn btn-outline-success" href="{{ path('app_prestaties_export', filter) }}"><i class="bi bi-file-earmark-excel"></i> Exporteren naar Excel</a>
    </div>
    <form class="card card-body mb-3" method="get">
        <div class="row g-2 align-items-end">
            {% if personen %}
                <div class="col-md-5">
                    <label class="form-label" for="persoon">Persoon</label>
                    <select class="form-select" id="persoon" name="persoon" data-zoekbaar>
                        {% for p in personen %}
                            <option value="{{ p.id }}" {{ p.id == persoon.id ? 'selected' }}>{{ p.naam }} {{ p.voornaam }} · {{ p.tiknummer }}{{ not p.actief ? ' (inactief)' }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-6 col-md-2"><label class="form-label" for="van">Van</label><input class="form-control" type="date" id="van" name="van" value="{{ van ? van|date('Y-m-d') }}"></div>
            <div class="col-6 col-md-2"><label class="form-label" for="tot">Tot en met</label><input class="form-control" type="date" id="tot" name="tot" value="{{ tot ? tot|date('Y-m-d') }}"></div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary"><i class="bi bi-funnel"></i> Toepassen</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_prestaties', {van: 'now'|date('Y-m-01'), tot: 'now'|date('Y-m-t'), persoon: filter.persoon ?? null}|filter(v => v is not null)) }}">Deze maand</a>
            </div>
        </div>
    </form>
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3"><div class="card card-body"><div class="text-body-secondary small">Interventies</div><div class="fs-3 fw-semibold tabular">{{ tikkingen|length }}</div></div></div>
        <div class="col-sm-6 col-lg-3"><div class="card card-body"><div class="text-body-secondary small">Totale prestatie</div><div class="fs-3 fw-semibold tabular">{{ totaal|duur }}</div></div></div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Lijst</th><th>Start interventie</th><th>Interventie</th><th>Begin</th><th>Einde</th><th>Prestatie</th></tr></thead>
                <tbody>
                {% for t in tikkingen %}
                    <tr>
                        <td>{% if is_granted('ROLE_LIJSTEN') %}<a href="{{ path('app_lijst_toon', {id: t.lijst.id}) }}">{{ t.lijst.label }}</a>{% else %}{{ t.lijst.label }}{% endif %}</td>
                        <td class="tabular">{{ t.lijst.start|format_datetime(pattern: 'EEE dd/MM/yyyy HH:mm', locale: 'nl') }}</td>
                        <td>{{ t.lijst.interventieType ? t.lijst.interventieType.naam }} te {{ t.lijst.gemeente ? t.lijst.gemeente.naam }}</td>
                        <td class="tabular">{{ t.start|date('d/m/Y H:i') }}</td>
                        <td class="tabular">{{ t.einde|date('d/m/Y H:i') }}</td>
                        <td class="tabular">{{ t.prestatie|duur }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-body-secondary py-4">Geen tikkingen in deze periode.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">{{ m.paginering(pagina, paginas, 'app_prestaties', filter) }}</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block navbar %}{% endblock %}
{% block body %}
<div class="card mx-auto" style="max-width:460px"><div class="card-body">
<h1 class="h4">Superadmin aanmelden</h1>
{% if fout %}<div class="alert alert-danger">Aanmelden mislukt. Controleer je e-mail, wachtwoord en authenticatorcode. Wacht bij een reeds gebruikte code op de volgende code.</div>{% endif %}
<form method="post" action="{{ path('app_superadmin_login') }}">
<label class="form-label" for="admin-email">E-mail</label><input class="form-control mb-3" id="admin-email" name="email" type="email" value="{{ email }}" autocomplete="username" required>
<label class="form-label" for="admin-password">Wachtwoord</label><input class="form-control mb-3" id="admin-password" name="password" type="password" autocomplete="current-password" required>
<label class="form-label" for="admin-totp">Authenticatorcode</label><input class="form-control mb-3" id="admin-totp" name="totp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('superadmin_login') }}">
<button class="btn btn-primary w-100">Aanmelden</button>
</form></div></div>
{% endblock %}

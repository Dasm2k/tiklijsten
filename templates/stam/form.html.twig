{% extends 'base.html.twig' %}
{% block body %}
    <h1 class="h3 mb-3">{{ item.id ? cfg.enkelvoud|capitalize ~ ' bewerken' : 'Nieuwe ' ~ cfg.enkelvoud }}</h1>
    <div class="card" style="max-width: 640px"><div class="card-body">
        {{ form_start(form) }}
        {{ form_rest(form) }}
        <button class="btn btn-primary"><i class="bi bi-save"></i> Opslaan</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_stam_index', {soort: soort}) }}">Annuleren</a>
        {{ form_end(form) }}
    </div></div>
{% endblock %}

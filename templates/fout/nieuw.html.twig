{% extends 'base.html.twig' %}
{% block body %}
    {% set melder = melder|default(app.user) %}
    <h1 class="h3 mb-3">Nieuwe foutmelding</h1>
    <div class="card" style="max-width: 820px"><div class="card-body">
        <p class="text-body-secondary">Melder: <strong>{{ melder.voornaam }} {{ melder.naam }}</strong>{{ melder.email ? ' (' ~ melder.email ~ ')' }}</p>
        {{ form_start(form) }}
        {{ form_row(form.type) }}
        {{ form_row(form.voertuig) }}
        {{ form_row(form.wat) }}
        {{ form_row(form.kledij) }}
        {{ form_row(form.genummerd) }}
        {{ form_row(form.soortKadaver) }}
        {{ form_row(form.locatieKadaver) }}
        {{ form_row(form.inOpdrachtVan) }}
        {{ form_rest(form) }}
        <button class="btn btn-primary"><i class="bi bi-send"></i> Foutmelding versturen</button>
        {% if not post_melding|default(false) %}<a class="btn btn-outline-secondary" href="{{ path('app_fout_index') }}">Annuleren</a>{% endif %}
        {{ form_end(form) }}
        {% if post_melding|default(false) %}
            <form method="post" action="{{ path('app_fout_post_afmelden') }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('post_fout_afmelden') }}">
                <button class="btn btn-outline-secondary" type="submit">Annuleren en terug naar tik-pc</button>
            </form>
        {% endif %}
    </div></div>
{% endblock %}

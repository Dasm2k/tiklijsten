{% extends 'base.html.twig' %}
{% block body %}<h1 class="h3">Prullenbak</h1><p>Verwijderde gegevens blijven bewaard en tellen niet meer mee in lijsten, prestaties of exports.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Type</th><th>Gegevens</th><th>Verwijderd op</th><th></th></tr></thead><tbody>{% for i in items %}<tr><td>{{ i.type|capitalize }}</td><td>{{ i.label }}</td><td>{{ i.entity.verwijderdOp|date('d/m/Y H:i:s') }}</td><td><form method="post" action="{{ path('app_herstellen',{type:i.type,id:i.entity.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('herstel' ~ i.type ~ i.entity.id) }}"><button class="btn btn-sm btn-outline-primary">Herstellen</button></form></td></tr>{% else %}<tr><td colspan="4">Geen verwijderde gegevens.</td></tr>{% endfor %}</tbody></table></div><a href="{{ path('app_handelingen') }}">Naar het handelingenlog</a>{% endblock %}

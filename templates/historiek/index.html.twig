{% extends 'base.html.twig' %}
{% block body %}
<div class="d-flex justify-content-between mb-3"><h1 class="h3">Handelingenlog</h1><a class="btn btn-outline-secondary" href="{{ path('app_prullenbak') }}">Prullenbak</a></div>
<form class="d-flex gap-2 mb-3" method="get"><select class="form-select w-auto" name="actie"><option value="">Alle handelingen</option>{% for a in ['aanmaken','wijzigen','verwijderen','herstellen','afsluiten','heropenen','relatie wijzigen','verzoek','console'] %}<option value="{{ a }}" {{ actie == a ? 'selected' }}>{{ a|capitalize }}</option>{% endfor %}</select>{% if is_granted('ROLE_SUPERADMIN') %}<label class="form-check-label align-self-center"><input class="form-check-input" type="checkbox" name="systeem" value="1" {{ app.request.query.getBoolean('systeem') ? 'checked' }}> Ook systeemacties</label>{% endif %}<button class="btn btn-primary">Filteren</button></form>
<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Wanneer</th><th>Door wie</th><th>Handeling</th><th>Object</th><th>Details</th></tr></thead><tbody>
{% for h in handelingen %}<tr><td>{{ h.datum|date('d/m/Y H:i:s') }}</td><td>{{ h.actor }}{% if h.actorId %} (#{{ h.actorId }}){% endif %}</td><td><span class="badge text-bg-secondary">{{ h.actie }}</span></td><td>{{ h.objectType|split('\\')|last }} {{ h.objectId ? '#' ~ h.objectId }}</td><td><details><summary>{{ h.route }}</summary><div class="small">Verzoek: {{ h.requestId }}</div><strong>Voor</strong><pre class="small text-wrap">{{ h.voor|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre><strong>Na</strong><pre class="small text-wrap">{{ h.na|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></td></tr>{% else %}<tr><td colspan="5">Geen handelingen gevonden.</td></tr>{% endfor %}
</tbody></table></div><div class="d-flex gap-2">{% if pagina > 1 %}<a class="btn btn-outline-secondary" href="{{ path('app_handelingen',app.request.query.all|merge({p:pagina-1})) }}">Vorige</a>{% endif %}{% if handelingen|length == 50 %}<a class="btn btn-outline-secondary" href="{{ path('app_handelingen',app.request.query.all|merge({p:pagina+1})) }}">Volgende</a>{% endif %}</div>
{% endblock %}

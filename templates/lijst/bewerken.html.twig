{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('vendor/tom-select/tom-select.bootstrap5.min.css') }}">{% endblock %}
{% block javascripts %}<script src="{{ asset('vendor/tom-select/tom-select.complete.min.js') }}"></script>{% endblock %}
{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">Lijst {{ lijst.label }} bewerken {{ m.lijst_status(lijst) }}</h1>
        <a class="btn btn-outline-secondary" href="{{ path('app_lijst_toon', {id: lijst.id}) }}"><i class="bi bi-eye"></i> Bekijken</a>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            {{ form_start(form) }}
            <div class="row">
                <div class="col-md-4">{{ form_row(form.start) }}</div>
                <div class="col-md-4">{{ form_row(form.tweedeStart) }}</div>
                <div class="col-md-4">{{ form_row(form.peloton) }}</div>
                <div class="col-md-4">{{ form_row(form.post) }}</div>
                <div class="col-md-4">{{ form_row(form.gemeente) }}</div>
                <div class="col-md-4">{{ form_row(form.interventieType) }}</div>
                <div class="col-md-4">{{ form_row(form.bevelvoerder) }}</div>
                <div class="col-md-4">{{ form_row(form.centralist) }}</div>
                <div class="col-md-4">{{ form_row(form.info) }}</div>
            </div>
            {{ form_rest(form) }}
            <button class="btn btn-primary"><i class="bi bi-save"></i> Wijzigingen opslaan</button>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Tikkingen</div>
        <div class="table-responsive">{% include 'lijst/_tikkingen.html.twig' with {verwijderbaar: true} %}</div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Tikking toevoegen</div>
        <div class="card-body">
            <form method="post" action="{{ path('app_lijst_tikking_toevoegen', {id: lijst.id}) }}" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="persoon">Persoon</label>
                    <select id="persoon" name="persoon" class="form-select" data-zoekbaar required>
                        <option value=""></option>
                        {% for p in personen %}<option value="{{ p.id }}">{{ p.naam }} {{ p.voornaam }} ({{ p.tiknummer }})</option>{% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="start">Eigen beginuur <span class="text-body-secondary">(optioneel)</span></label>
                    <input type="datetime-local" id="start" name="start" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="einde">Einde</label>
                    <input type="datetime-local" id="einde" name="einde" class="form-control" required value="{{ lijst.start|date('Y-m-d\\TH:i') }}">
                </div>
                <div class="col-md-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('tikking' ~ lijst.id) }}">
                    <button class="btn btn-outline-primary w-100"><i class="bi bi-plus"></i> Toevoegen</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

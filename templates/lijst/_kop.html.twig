{% import '_macros.html.twig' as m %}
<div class="row g-2 small lijst-gegevens">
    <div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Post</span><br><span class="lijst-gegeven-waarde">{{ lijst.post ? lijst.post.naam : '-' }}</span></div>
    <div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Peloton</span><br><span class="lijst-gegeven-waarde">{{ lijst.peloton|peloton }}</span></div>
    <div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Begin</span><br><span class="lijst-gegeven-waarde tabular">{{ lijst.start|date('d/m/Y H:i') }}</span></div>
    {% if lijst.tweedeStart %}<div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">2de beginuur</span><br><span class="lijst-gegeven-waarde tabular">{{ lijst.tweedeStart|date('d/m/Y H:i') }}</span></div>{% endif %}
    <div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Interventie</span><br><span class="lijst-gegeven-waarde">{{ lijst.interventieType ? lijst.interventieType.naam }} te {{ lijst.gemeente ? lijst.gemeente.naam }}</span></div>
    {% if lijst.interventienummer is not null %}<div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Interventie #</span><br><span class="lijst-gegeven-waarde">{{ lijst.interventienummer }}</span></div>{% endif %}
    {% if not lijst.speciaal %}<div class="col-sm-6 col-lg-3"><span class="text-body-secondary lijst-gegeven-label">Bevelvoerder</span><br><span class="lijst-gegeven-waarde">{{ m.persoon(lijst.bevelvoerder) }}</span></div>{% endif %}
    <div class="col-lg-6 lijst-gegeven-info"><span class="text-body-secondary lijst-gegeven-label">Info</span><br><span class="lijst-gegeven-waarde">{{ lijst.info ?: '-' }}</span></div>
</div>

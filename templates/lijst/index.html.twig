{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block body %}
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">{{ archief ? 'Archief' : 'Aanwezigheidslijsten' }}</h1>
        <div class="d-flex gap-2">
            <form class="d-flex gap-2" method="get">
                {% if archief %}<input type="hidden" name="archief" value="1">{% endif %}
                <input class="form-control" type="search" name="zoek" value="{{ zoek }}" placeholder="Lijst- of interventienummer, gemeente…" aria-label="Zoeken">
                <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
            </form>
            {% if is_granted('ROLE_ARCHIEF') %}
                <a class="btn btn-outline-secondary text-nowrap" href="{{ path('app_lijst_index', archief ? {} : {archief: 1}) }}"><i class="bi bi-archive"></i> {{ archief ? 'Lopende lijsten' : 'Archief' }}</a>
            {% endif %}
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Lijst</th><th>Post</th><th>Datum</th><th>Peloton</th><th>Bevelvoerder</th><th>Gemeente</th><th>Interventie</th><th>Status</th><th class="text-end">Acties</th></tr></thead>
                <tbody>
                {% for lijst in lijsten %}
                    <tr class="{{ not lijst.afgesloten ? 'table-warning' }}" {% if lijst.info %}title="{{ lijst.info }}"{% endif %}>
                        <td><a href="{{ path('app_lijst_toon', {id: lijst.id}) }}">{{ lijst.label }}</a></td>
                        <td>{{ lijst.post ? lijst.post.naam }}</td>
                        <td class="tabular text-nowrap">{{ lijst.start|date('d/m/Y H:i') }}</td>
                        <td class="text-nowrap">{{ lijst.peloton|peloton }}</td>
                        <td>{{ m.persoon(lijst.bevelvoerder) }}</td>
                        <td>{{ lijst.gemeente ? lijst.gemeente.naam }}</td>
                        <td>{{ lijst.interventieType ? lijst.interventieType.naam }}{% if lijst.interventienummer is not null %}<div class="small text-body-secondary">Interventie #: {{ lijst.interventienummer }}</div>{% endif %}</td>
                        <td>{{ m.lijst_status(lijst) }}</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-link" href="{{ path('app_lijst_bewerken', {id: lijst.id}) }}" title="Bewerken"><i class="bi bi-pencil"></i></a>
                            {% if is_granted('LIJST_AFDRUKKEN', lijst) %}<a class="btn btn-sm btn-link" href="{{ path('app_lijst_afdrukken', {id: lijst.id}) }}" title="Afdrukken"><i class="bi bi-printer"></i></a>{% endif %}
                            {% if is_granted('ROLE_ARCHIEF') and not lijst.gearchiveerd %}
                                <form method="post" action="{{ path('app_lijst_open_sluiten', {id: lijst.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ lijst.id) }}">
                                    <button class="btn btn-sm btn-link" title="{{ lijst.afgesloten ? 'Heropenen' : 'Sluiten' }}"><i class="bi bi-{{ lijst.afgesloten ? 'unlock' : 'lock' }}"></i></button>
                                </form>
                                <form method="post" action="{{ path('app_lijst_archiveren', {id: lijst.id}) }}" class="d-inline" data-bevestig="Lijst {{ lijst.label }} archiveren?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('archief' ~ lijst.id) }}">
                                    <button class="btn btn-sm btn-link" title="Archiveren"><i class="bi bi-archive"></i></button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="text-center text-body-secondary py-4">Geen lijsten gevonden.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">{{ m.paginering(pagina, paginas, 'app_lijst_index', {archief: archief ? 1 : null, zoek: zoek}|filter(v => v is not null)) }}</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Aanwezigheidslijst {{ lijst.label }}{% endblock %}
{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}
{% block body %}
    <div data-auto-print data-terug="{{ terug }}">
        <div class="geen-print d-flex gap-2 mb-3">
            <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Afdrukken</button>
            <a class="btn btn-outline-secondary" href="{{ terug }}">Terug</a>
        </div>
        <div class="card mb-3">
            <div class="card-body d-flex gap-3 align-items-start">
                <img src="{{ asset('img/logo.png') }}" alt="" width="80" height="80">
                <div class="flex-grow-1">
                    <h1 class="h4">{{ lijst.afdeling.titel }} - Aanwezigheidslijst {{ lijst.post ? 'post ' ~ lijst.post.naam }} {{ lijst.label }}</h1>
                    {% include 'lijst/_kop.html.twig' %}
                </div>
            </div>
        </div>
        {% if herinneringen %}
            <div class="card mb-3"><div class="card-body">
                {% for h in herinneringen %}
                    <div class="form-check"><i class="bi bi-square p-2"></i><label class="form-check-label" for="h{{ h.id }}">{{ h.vraag }}</label></div>
                {% endfor %}
            </div></div>
        {% endif %}
        <div class="card"><div class="card-body p-0">{% include 'lijst/_tikkingen.html.twig' %}</div></div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block body %}
    <h1 class="h3 mb-3">{{ persoon.id ? persoon.voornaam ~ ' ' ~ persoon.naam ~ ' bewerken' : 'Nieuw personeelslid' }}</h1>
    <div class="card"><div class="card-body">
        {{ form_start(form) }}
        <div class="row">
            <div class="col-md-3">{{ form_row(form.tiknummer) }}</div>
            <div class="col-md-3">{{ form_row(form.zonenummer) }}</div>
            <div class="col-md-3">{{ form_row(form.naam) }}</div>
            <div class="col-md-3">{{ form_row(form.voornaam) }}</div>
            <div class="col-md-3">{{ form_row(form.rang) }}</div>
            <div class="col-md-3">{{ form_row(form.peloton) }}</div>
            <div class="col-md-3">{{ form_row(form.post) }}</div>
            <div class="col-md-3">{{ form_row(form.email) }}</div>
            <div class="col-md-3">{{ form_row(form.nieuweCode.first) }}</div>
            <div class="col-md-3">{{ form_row(form.nieuweCode.second) }}</div>
            <div class="col-md-3">{{ form_row(form.rol) }}</div>
            <div class="col-md-3">{{ form_row(form.sessieduur) }}</div>
            <div class="col-12">{{ form_row(form.beroeps) }}</div>
        </div>
        {% if persoon.id %}<p class="form-text">Laat de code leeg om ze niet te wijzigen.</p>{% endif %}
        {{ form_rest(form) }}
        <button class="btn btn-primary"><i class="bi bi-save"></i> Opslaan</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_personeel_index') }}">Annuleren</a>
        {{ form_end(form) }}
    </div></div>
{% endblock %}
